---
import '../styles/global.css';
import { tracks } from '../lib/tracks';
interface Props { title?: string; description?: string }
const { title, description = 'Train the first 30 seconds of a coding problem: spot the tell, name the pattern.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const nav = tracks.map((t) => ({ prefix: `${base}${t.slug}/`, label: t.short }));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
    <title>{title ? `${title} · Tells` : 'Tells: every problem has a tell'}</title>
  </head>
  <body>
    <header class="site-head">
      <a class="logo" href={base}><span class="logo-dot" />tells</a>
      <nav>
        {nav.map((n) => <a href={`${n.prefix}drill/`} aria-current={path.startsWith(n.prefix) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-foot">
      <span>Every problem has a tell.</span>
      <span class="muted">Not a LeetCode replacement. The warm-up before it.</span>
    </footer>
  </body>
</html>
