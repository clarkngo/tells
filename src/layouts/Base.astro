---
import '../styles/global.css';
import { tracks } from '../lib/tracks';
import Player from '../components/Player';
interface Props { title?: string; description?: string }
const { title, description = 'Train the first 30 seconds of any problem, from algorithms, system design and AI to data science, production debugging and first principles: spot the tell, name the pattern.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const nav = tracks.map((t) => ({ prefix: `${base}${t.slug}/`, label: t.short }));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
    <title>{title ? `${title} · Tells` : 'Tells: every problem has a tell'}</title>
  </head>
  <body>
    <header class="site-head">
      <a class="logo" href={base}><span class="logo-dot" />tells</a>
      <div class="head-right">
        <nav>
          {nav.map((n) => <a href={`${n.prefix}drill/`} aria-current={path.startsWith(n.prefix) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <Player client:only="preact" />
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-foot">
      <span>Every problem has a tell.</span>
      <a href={`${base}gallery/`}>Pattern gallery</a>
      <a href={`${base}sync/`}>Sync progress</a>
      <span class="muted">Designed and built by Clark Ngo.</span>
      <span class="muted credit">
        Music by <a href="https://pixabay.com/users/the_mountain-3616498/?utm_source=link-attribution&utm_medium=referral&utm_campaign=music&utm_content=602501">Dmitrii Kolesnikov</a>
        from <a href="https://pixabay.com//?utm_source=link-attribution&utm_medium=referral&utm_campaign=music&utm_content=602501">Pixabay</a>
      </span>
    </footer>
  </body>
</html>
