---
import '../styles/global.css';
import { tracks } from '../lib/tracks';
import Player from '../components/Player';
import MapLink from '../components/MapLink';
interface Props { title?: string; description?: string }
const { title, description = 'Train the first 30 seconds of any problem, from algorithms, system design, frontend and backend to AI, prompts, specs, data science, production debugging and first principles: spot the tell, name the pattern.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const nav = tracks.map((t) => ({ prefix: `${base}${t.slug}/`, label: t.short }));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <meta name="apple-mobile-web-app-title" content="Tells" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="theme-color" content="#0b0f14" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f8fa" media="(prefers-color-scheme: light)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
    <script is:inline>
      // Saved drill text size, applied before paint (see lib/textsize.ts).
      try { var i = localStorage.getItem('tells:v1:textsize'); var z = [0.92, 1, 1.12, 1.26][+i]; if (i !== null && z) document.documentElement.style.setProperty('--ts', z); } catch (e) {}
    </script>
    <title>{title ? `${title} · Tells` : 'Tells: every problem has a tell'}</title>
  </head>
  <body>
    <header class="site-head">
      <a class="logo" href={base}><span class="logo-dot" />tells</a>
      <div class="head-right">
        <nav>
          {nav.map((n) => <a href={`${n.prefix}drill/`} aria-current={path.startsWith(n.prefix) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <MapLink client:load href={`${base}map/`} current={path.startsWith(`${base}map`)} />
        <Player client:only="preact" />
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-foot">
      <span>Every problem has a tell.</span>
      <a href={`${base}gallery/`}>Pattern gallery</a>
      <a href={`${base}map/`}>Progress map</a>
      <a href={`${base}sync/`}>Sync progress</a>
      <span class="muted offline-note" hidden>Saved for offline use</span>
      <span class="muted">Designed and built by Clark Ngo.</span>
      <span class="muted credit">
        Music by <a href="https://pixabay.com/users/the_mountain-3616498/?utm_source=link-attribution&utm_medium=referral&utm_campaign=music&utm_content=602501">Dmitrii Kolesnikov</a>
        from <a href="https://pixabay.com//?utm_source=link-attribution&utm_medium=referral&utm_campaign=music&utm_content=602501">Pixabay</a>
      </span>
      <span class="muted credit">
        Music by <a href="https://pixabay.com/users/zephiramusic-54643547/?utm_source=link-attribution&utm_medium=referral&utm_campaign=music&utm_content=612040">Marek Zielinski</a>
        from <a href="https://pixabay.com//?utm_source=link-attribution&utm_medium=referral&utm_campaign=music&utm_content=612040">Pixabay</a>
      </span>
    </footer>
    <script>
      // Offline: register the service worker (production only) and say so in
      // the footer once the pages are saved.
      if ('serviceWorker' in navigator && import.meta.env.PROD) {
        const base = import.meta.env.BASE_URL;
        const note = () => caches.keys().then((ks) => {
          const el = document.querySelector<HTMLElement>('.offline-note');
          if (el) el.hidden = !ks.some((k) => k.startsWith('tells-pages-'));
        }).catch(() => {});
        navigator.serviceWorker.register(`${base}sw.js`, { scope: base }).then(note, () => {});
        navigator.serviceWorker.addEventListener('controllerchange', note);
        note();
      }
    </script>
  </body>
</html>
