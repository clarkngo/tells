---
import Base from '../../layouts/Base.astro';
import Review from '../../components/Review';
const base = import.meta.env.BASE_URL;
---
<Base title="Fix my misses" description="One untimed round of the questions you last missed, peeked at or guessed, from every track.">
  <section class="page-head">
    <p class="eyebrow">Review</p>
    <h1>Fix my misses</h1>
    <p class="muted">The questions you last got wrong, peeked at or only guessed right, from every track. No timer. Get one right and it leaves the list.</p>
  </section>
  <Review client:only="preact" base={base}>
    <div slot="fallback" class="drill skeleton">Finding your misses…</div>
  </Review>
</Base>
