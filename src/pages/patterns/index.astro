---
import Base from '../../layouts/Base.astro';
import Glyph from '../../components/Glyph';
import { dsa } from '../../lib/tracks';
const base = import.meta.env.BASE_URL;
const count = (slug: string) => dsa.problems.filter((p) => p.answer === slug).length;
---
<Base title="Patterns">
  <section class="page-head">
    <h1>Patterns</h1>
    <p class="muted">The signals to listen for. Live patterns have drills; the rest are on the way.</p>
  </section>
  <div class="grid">
    {dsa.patterns.map((p) => (
      <article class={`card ${p.live ? '' : 'soon'}`} style={`--h:${p.hue}`}>
        <div class="card-top">
          <h2 class="pname">{p.name}</h2>
          {p.live ? <span class="mono muted">{count(p.slug)} problems</span> : <span class="badge">Soon</span>}
        </div>
        {p.live && <Glyph slug={p.slug} hue={p.hue} />}
        <p>{p.blurb}</p>
        <ul class="signals">{p.signals.map((s) => <li>{s}</li>)}</ul>
        {p.live && <a class="card-link" href={`${base}drill/?focus=${p.slug}`}>Drill this pattern →</a>}
      </article>
    ))}
  </div>
</Base>
