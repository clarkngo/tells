---
import Base from '../../layouts/Base.astro';
import Glyph from '../../components/Glyph';
import { tracks } from '../../lib/tracks';
import type { Track } from '../../lib/types';

export function getStaticPaths() {
  return tracks.map((t) => ({ params: { track: t.slug }, props: { t } }));
}
const { t } = Astro.props as { t: Track };
const base = import.meta.env.BASE_URL;
const count = (slug: string) => t.problems.filter((p) => p.answer === slug).length;
const noun = t.slug === 'dsa' ? 'problems' : 'scenarios';
---
<Base title={`${t.short} patterns`}>
  <section class="page-head">
    <p class="eyebrow">{t.name}</p>
    <h1>{t.slug === 'dsa' ? 'Patterns' : 'Building blocks'}</h1>
    <p class="muted">The signals to listen for. Live ones have drills; the rest are on the way.</p>
  </section>
  <div class="grid">
    {t.patterns.map((p) => (
      <article class={`card ${p.live ? '' : 'soon'}`} style={`--h:${p.hue}`}>
        <div class="card-top">
          <h2 class="pname">{p.name}</h2>
          {p.live ? <span class="mono muted">{count(p.slug)} {noun}</span> : <span class="badge">Soon</span>}
        </div>
        {p.live && <Glyph slug={p.slug} hue={p.hue} />}
        <p>{p.blurb}</p>
        <ul class="signals">{p.signals.map((s) => <li>{s}</li>)}</ul>
        {p.live && <a class="card-link" href={`${base}${t.slug}/drill/?focus=${p.slug}`}>Drill this →</a>}
      </article>
    ))}
  </div>
</Base>
